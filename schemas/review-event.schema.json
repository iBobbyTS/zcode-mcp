{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcode.local/schemas/review-event.schema.json",
  "title": "ZCode review report checkpoint event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "agent_id", "revision", "finalized"],
  "properties": {
    "schema": { "const": "sectioned-zcode-review-event/v1" },
    "type": { "const": "report.checkpoint" },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "finalized": { "type": "boolean" }
  }
}
