{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcode.local/schemas/review-manifest.schema.json",
  "title": "Sectioned ZCode Review Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_kind",
    "feature_id",
    "section_id",
    "round_kind",
    "repository",
    "base_ref",
    "head_ref",
    "plan_path",
    "context_paths",
    "scope_paths",
    "forbidden_input_globs",
    "validation_commands",
    "report_target",
    "scratch_root",
    "fresh_session",
    "network_policy",
    "scratch_policy",
    "idempotency_key"
  ],
  "properties": {
    "schema": { "const": "sectioned-zcode-review/v1" },
    "review_kind": { "enum": ["plan", "code"] },
    "feature_id": { "$ref": "#/$defs/id" },
    "section_id": { "$ref": "#/$defs/id" },
    "round_kind": {
      "enum": ["PLAN_REVIEW", "INITIAL_BOUNDED", "REPAIR_DELTA", "FINAL_BOUNDED"]
    },
    "repository": { "type": "string", "minLength": 1 },
    "base_ref": { "$ref": "#/$defs/sha" },
    "head_ref": { "$ref": "#/$defs/sha" },
    "plan_path": { "type": "string", "minLength": 1 },
    "context_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "scope_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbidden_input_globs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "validation_commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" },
      "uniqueItems": true,
      "x-unique-by": "id"
    },
    "report_target": { "type": "string", "minLength": 1 },
    "scratch_root": { "type": "string", "minLength": 1 },
    "model": { "type": ["string", "null"], "pattern": "\\S" },
    "fresh_session": { "const": true },
    "network_policy": { "enum": ["deny", "allow"] },
    "scratch_policy": { "const": "isolated" },
    "idempotency_key": { "$ref": "#/$defs/idempotencyKey" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "minLength": 1, "maxLength": 256 },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "minLength": 1, "maxLength": 512 },
    "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program", "args", "cwd", "timeout_ms", "max_output_bytes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "program": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    }
  }
}
