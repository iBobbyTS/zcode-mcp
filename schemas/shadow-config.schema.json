{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcode.local/schemas/shadow-config.schema.json",
  "title": "Sectioned ZCode Shadow Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "manifest_path", "artifact_directory", "artifact_stem", "mode",
    "wait_timeout_ms", "max_waits"
  ],
  "properties": {
    "schema": { "const": "sectioned-zcode-shadow/v1" },
    "manifest_path": { "type": "string", "minLength": 1 },
    "artifact_directory": { "type": "string", "minLength": 1 },
    "artifact_stem": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,160}$" },
    "mode": { "enum": ["full", "delta_consultation", "resume_consultation"] },
    "wait_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 5000 },
    "max_waits": { "type": "integer", "minimum": 1, "maximum": 1000 }
  }
}
