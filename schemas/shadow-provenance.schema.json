{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcode.local/schemas/shadow-provenance.schema.json",
  "title": "Sectioned ZCode Shadow Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "agent_id", "submission_disposition", "zcode_session_id",
    "fresh_session_observed", "classification", "review_kind", "round_kind",
    "manifest_sha256", "prepared_sha256", "prompt_sha256", "base_sha",
    "head_sha", "report_sha256", "report_bytes", "report_schema_compliant",
    "checkpoint_count", "unsupported_input_observed", "runtime_failure_observed",
    "wall_time_ms"
  ],
  "properties": {
    "schema": { "const": "sectioned-zcode-shadow/v1" },
    "agent_id": { "type": "string", "minLength": 1 },
    "submission_disposition": { "enum": ["created", "existing_compatible"] },
    "zcode_session_id": { "type": ["string", "null"] },
    "fresh_session_observed": { "type": "boolean" },
    "classification": { "enum": ["independent_evidence", "consultation", "evidence_incomplete"] },
    "review_kind": { "enum": ["plan", "code"] },
    "round_kind": { "enum": ["PLAN_REVIEW", "INITIAL_BOUNDED", "REPAIR_DELTA", "FINAL_BOUNDED"] },
    "manifest_sha256": { "type": ["string", "null"] },
    "prepared_sha256": { "type": ["string", "null"] },
    "prompt_sha256": { "type": "string", "minLength": 1 },
    "base_sha": { "type": ["string", "null"] },
    "head_sha": { "type": ["string", "null"] },
    "report_sha256": { "type": ["string", "null"] },
    "report_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "report_schema_compliant": { "type": "boolean" },
    "checkpoint_count": { "type": "integer", "minimum": 0 },
    "unsupported_input_observed": { "type": "boolean" },
    "runtime_failure_observed": { "type": "boolean" },
    "wall_time_ms": { "type": "integer", "minimum": 0 }
  }
}
