{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcode.local/schemas/review-report.schema.json",
  "title": "ZCode private review report artifact result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "locator",
    "expected_sha256",
    "expected_bytes",
    "observed_sha256",
    "observed_bytes",
    "checkpoint_number",
    "integrity",
    "preview_state",
    "preview"
  ],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "type": "string", "minLength": 1 },
    "locator": { "type": "string", "minLength": 1 },
    "expected_sha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "expected_bytes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "observed_sha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "observed_bytes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "checkpoint_number": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "integrity": {
      "enum": ["valid", "missing", "replaced", "binary", "invalid", "legacy_unverified"]
    },
    "preview_state": {
      "enum": ["available", "not_requested", "unavailable"]
    },
    "preview": { "type": ["string", "null"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
