{
  "name": "zcode-subagent-mcp",
  "version": "0.1.0",
  "description": "Local bounded ZCode subagent MCP facade with fail-closed policy hooks",
  "author": {
    "name": "zcode-mcp maintainers"
  },
  "interface": {
    "displayName": "ZCode Subagent MCP",
    "shortDescription": "Run bounded local ZCode agents.",
    "longDescription": "Connects Codex to the local stateless facade while the separately managed zcode-agentd daemon owns durable task lifecycle state.",
    "developerName": "zcode-mcp maintainers",
    "category": "Productivity",
    "capabilities": ["Local MCP", "Durable tasks", "Agent tasks"],
    "defaultPrompt": [
      "Check ZCode subagent readiness.",
      "Run a bounded repository analysis task.",
      "Run a bounded agent task."
    ]
  },
  "mcpServers": "./.mcp.json",
  "hooks": "./hooks/hooks.json",
  "hookPolicy": {
    "version": "zcode-agent-bash/v1.0.0",
    "bashPolicy": "./lib/bash-policy.mjs",
    "filePolicy": "./lib/agent-file-policy.mjs",
    "postToolUseAudit": true,
    "activation": "./hooks/hooks.json"
  }
}
